# Copy to .env. node app.js loads this file automatically.
PORT=3030
# Secure SSH tunnel default. Open http://127.0.0.1:3030 on YOUR PC via SSH.
PUBLIC_ORIGIN=http://127.0.0.1:3030
# For public access behind a TLS reverse proxy, set e.g.:
# PUBLIC_ORIGIN=https://162.35.181.135:3443
DATA_DIR=./runtime
SESSION_HOURS=8
BROWSER_IDLE_MINUTES=30
