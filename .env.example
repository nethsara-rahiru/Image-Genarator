NODE_ENV=production
HOST=127.0.0.1
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/gemini_agent
SESSION_SECRET=replace-with-at-least-32-random-characters
PUBLIC_ORIGIN=https://localhost:3443
DATA_DIR=./runtime
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GENERATION_TIMEOUT_MS=240000
LEASE_MS=30000
# Interactive login lifetime: 1–30 minutes (milliseconds).
LOGIN_SESSION_MS=900000
# TLS proxy on loopback, or built-in TLS (required for Secure cookies over SSH tunnel)
TLS_KEY=
TLS_CERT=
