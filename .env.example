# Optional; node app.js works with local defaults without this file.
AUTH_REQUIRED=false
GENERATION_TIMEOUT_SECONDS=180
AUTOMATION_STEP_DELAY_MS=1000
GENERATION_UPLOAD_TIMEOUT_SECONDS=60
GENERATION_READY_TIMEOUT_SECONDS=45
PORT=3030
PUBLIC_ORIGIN=http://127.0.0.1:3030
DATA_DIR=./runtime
AUTO_OPEN=true
# Normally autodetected. Set only for a nonstandard desktop Chrome/Edge install.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
SESSION_HOURS=8
BROWSER_IDLE_MINUTES=30
# To use a TLS gateway, change PUBLIC_ORIGIN and follow docs/deployment.md.
# Optional native-mode recovery; background mode uses dashboard server settings.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional guided HTTPS access for another PC on the same LAN: node app.js --lan
# LAN_HOST=192.168.1.50
# LAN_PORT=3443
# CADDY_PATH=/absolute/path/to/caddy
