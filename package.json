{
  "name": "gemini-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "worker": "node --env-file-if-exists=.env worker.js",
    "setup-admin": "node --env-file-if-exists=.env scripts/setup-admin.js",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js tests/browser/*.test.js tests/e2e/*.test.js",
    "lint": "node scripts/check.js && prettier --check .",
    "format": "prettier --write .",
    "backup": "node --env-file=.env scripts/backup.js",
    "test:live": "node --env-file=.env --test tests/e2e/live.test.js"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "connect-mongo": "^5.1.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "file-type": "^21.0.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.19.0",
    "multer": "^2.0.2",
    "playwright": "^1.56.0",
    "sharp": "^0.35.5",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.2.3",
    "prettier": "^3.9.10",
    "supertest": "^7.1.4"
  }
}
