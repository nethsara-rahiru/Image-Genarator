{
  "name": "private-vps-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env app.js",
    "setup-admin": "node --env-file-if-exists=.env scripts/admin.js",
    "reset-admin": "node --env-file-if-exists=.env scripts/admin.js --reset",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "lint": "node scripts/check.js && prettier --check .",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.js"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "playwright": "^1.56.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
