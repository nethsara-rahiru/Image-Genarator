PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/marketing_agent
# Use a long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Groq creates text prompts only. Secrets stay on the backend.
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Existing Image-Genarator API; include /api/v1. Token scopes: read,generate,browser.
# Use HTTPS remotely; HTTP is accepted only for loopback on the same computer.
IMAGE_API_BASE_URL=http://127.0.0.1:3030/api/v1
IMAGE_API_KEY=
IMAGE_API_AUTO_START=true
PROMOTION_POLL_MS=3000
PROMOTION_REQUEST_TIMEOUT_MS=30000
PROMOTION_IMAGE_TIMEOUT_MS=900000
PROMOTION_MAX_IMAGE_BYTES=20971520

# Public CA used by your image API (export the CA certificate trusted by Postman).
# Loaded directly by Marketing Agent: npm start/dev work without Node TLS flags.
# File path: absolute, ~/..., or relative to backend/. Supports PEM CA bundles.
IMAGE_API_CA_FILE=
# Or paste public PEM here using a quoted multiline value or literal \n escapes.
# IMAGE_API_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Existing NODE_EXTRA_CA_CERTS file paths in .env are also accepted as a fallback.
